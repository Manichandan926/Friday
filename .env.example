# FRIDAY Configuration
# Copy this file to .env and fill in your values.

# LLM provider: groq, openai, gemini, or claude
DEFAULT_LLM_PROVIDER=groq

# Model for Groq/OpenAI. Keep this at ~70B-class or above while tool calling
# is in the chat path — smaller models (e.g. llama-3.1-8b-instant) fabricate
# answers instead of calling tools. See docs/adr/ADR-009.
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile

# API keys — you only need the one for the provider you use.
# Get a free Groq key at console.groq.com.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Model used when DEFAULT_LLM_PROVIDER is claude/anthropic
ANTHROPIC_MODEL=claude-opus-4-8

# Database
DATABASE_URL=sqlite:///database/friday.db

# Logging
LOG_LEVEL=INFO
